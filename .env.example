# OpenAI-compatible model service
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=
VISION_MODEL=

# Tavily paper discovery
TAVILY_API_KEY=
SEMANTIC_SCHOLAR_API_KEY=

# Batch settings
MAX_PARALLEL_PAPERS=2

# Image hosting: local | s3 | custom
IMAGE_HOST=local
PUBLIC_BASE_URL=

# S3-compatible hosting (AWS S3 / Cloudflare R2 / MinIO / OSS S3 gateway)
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=

# Custom uploader: multipart field "file"; response must contain url/data.url/data.link
CUSTOM_UPLOAD_URL=
CUSTOM_UPLOAD_TOKEN=

# Optional explicit Chromium/Edge path
BROWSER_EXECUTABLE=
